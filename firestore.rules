rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isApprovedSeller() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/seller_applications/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/seller_applications/$(request.auth.uid)).data.status == 'approved';
    }

    // User Profile security rules
    match /users/{userId} {
      // User can read their own profile; Admin can read any profile
      allow read: if isOwner(userId) || isAdmin();

      // User can create their profile upon registration (only as 'customer')
      allow create: if isOwner(userId)
                    && request.resource.data.role == 'customer'
                    && request.resource.data.uid == userId;

      // User can update basic details (strictly prevents changing role/uid); Admin can update user role
      allow update: if (isOwner(userId)
                        && request.resource.data.role == resource.data.role
                        && request.resource.data.uid == userId)
                    || isAdmin();

      // Deletion not permitted directly from frontend
      allow delete: if false;

      // Address subcollection rules
      match /addresses/{addressId} {
        allow read, create, update, delete: if isOwner(userId);
      }
    }

    // Seller Application security rules
    match /seller_applications/{userId} {
      // User can read their own application; Admin can read all applications; Public can read approved applications
      allow read: if isOwner(userId) || isAdmin() || (resource != null && resource.data.status == 'approved');

      // User can create their initial seller application (must be status 'pending' and match authenticated UID)
      allow create: if isOwner(userId)
                    && request.resource.data.uid == userId
                    && request.resource.data.status == 'pending';

      // User can update their own application to update profile (preserving current status) or resubmit (status 'pending');
      // Admin can update any application status (e.g., approve, reject, suspend)
      // Note: Sellers CANNOT alter financial wallet/balance fields directly
      allow update: if (isOwner(userId)
                        && request.resource.data.uid == userId
                        && request.resource.data.status == resource.data.status
                        && (!request.resource.data.keys().hasAny(['wallet', 'commissionRate'])))
                    || (isOwner(userId)
                        && request.resource.data.uid == userId
                        && request.resource.data.status == 'pending')
                    || isAdmin();

      // Only Admin can delete seller applications
      allow delete: if isAdmin();
    }

    // Products Collection
    match /products/{productId} {
      // Public can read published products; Sellers can read their own products; Admin can read all
      allow read: if resource == null || resource.data.status == 'published' || (isAuthenticated() && resource.data.sellerId == request.auth.uid) || isAdmin();

      // Only approved sellers can create products owned by themselves
      allow create: if isApprovedSeller() && request.resource.data.sellerId == request.auth.uid;

      // Only product owner (or admin) can update; sellerId cannot be transferred
      allow update: if (isApprovedSeller()
                        && resource.data.sellerId == request.auth.uid
                        && request.resource.data.sellerId == resource.data.sellerId)
                    || isAdmin();

      // Only product owner or admin can delete
      allow delete: if (isApprovedSeller() && resource.data.sellerId == request.auth.uid) || isAdmin();
    }

    match /stores/{storeId} {
      allow read: if true;
      allow write: if false;
    }

    // Orders Collection Rules
    match /orders/{orderId} {
      // Customer can read their own orders; Approved sellers can read orders containing their UID in sellerIds; Admin can read all
      allow read: if (isAuthenticated() && resource.data.customerId == request.auth.uid)
                  || (isApprovedSeller() && resource.data.sellerIds.hasAny([request.auth.uid]))
                  || isAdmin();

      // Customer can create an order owned by themselves
      allow create: if isAuthenticated() && request.resource.data.customerId == request.auth.uid;

      // Sellers can update order status but CANNOT alter customer identity, items, prices, payment status, totals, or seller ownership
      allow update: if (isApprovedSeller()
                        && resource.data.sellerIds.hasAny([request.auth.uid])
                        && request.resource.data.customerId == resource.data.customerId
                        && request.resource.data.sellerIds == resource.data.sellerIds
                        && request.resource.data.totalAmount == resource.data.totalAmount
                        && request.resource.data.paymentStatus == resource.data.paymentStatus
                        && request.resource.data.paymentMethod == resource.data.paymentMethod
                        && request.resource.data.items == resource.data.items
                        && request.resource.data.shippingAddress == resource.data.shippingAddress)
                    || isAdmin();

      // Only Admin can delete orders
      allow delete: if isAdmin();
    }

    // Withdrawal Requests Collection Rules
    match /withdrawal_requests/{requestId} {
      // Sellers can read their own withdrawal requests; Admins can read all
      allow read: if (isApprovedSeller() && resource.data.sellerUid == request.auth.uid) || isAdmin();

      // Approved sellers can submit a new withdrawal request owned by themselves with initial status 'pending'
      allow create: if isApprovedSeller()
                    && request.resource.data.sellerUid == request.auth.uid
                    && request.resource.data.status == 'pending';

      // Sellers CANNOT update or delete withdrawal requests once submitted; only Admin can update status or process payouts
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Financial Ledger / Audit Records (Admin & Server Managed)
    match /financial_ledger/{ledgerId} {
      allow read: if (isApprovedSeller() && resource.data.sellerUid == request.auth.uid) || isAdmin();
      allow write: if isAdmin();
    }
  }
}
